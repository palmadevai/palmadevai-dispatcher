# =============================================================================
# palmadevai-dispatcher — env vars (skeleton F1.2.a)
# =============================================================================
# Source of truth: palmadevai-apps/features/campaigns/manifest.yaml.
# Defaults aquí MATCHEAN los del manifest. NUNCA commitear este archivo con
# valores reales — usar BW `runtime-env` + `.env` del VPS en /srv/palmadev/<slug>/.
# =============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# Cliente metadata (consumido por logs estructurados + consumer_name)
CLIENT_SLUG=palmadevai
DOMAIN=devpalmawebs.com.ar
COCKPIT_URL=https://cockpit.devpalmawebs.com.ar
# HOSTNAME viene del container (docker compose se lo da). Si vacío, el worker
# usa "dispatcher-0" como fallback.
HOSTNAME=

# ── Worker config ───────────────────────────────────────────────────────────
DISPATCHER_CONCURRENCY=5
DISPATCHER_BATCH_SIZE=50
DISPATCHER_HEALTHCHECK_PORT=8080
DISPATCHER_METRICS_FLUSH_INTERVAL_SECONDS=30
DISPATCHER_BULLMQ_ATTEMPTS=3
DISPATCHER_BULLMQ_BACKOFF_MS=60000

# ── Redis (transport queue + pub/sub) ───────────────────────────────────────
# Pre-requisito: maxmemory-policy=noeviction + maxmemory>=1gb (palmadevai-infra
# v1.36.1+). Sin esto, Redis descarta jobs en silencio (Sidekiq #2883 / ADR-001).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CAMPAIGNS_STREAM=campaigns:stream
CAMPAIGNS_GROUP=dispatchers

# ── PostgreSQL (estado canónico — schema bot.*) ─────────────────────────────
APPDB_HOST=postgresql
APPDB_PORT=5432
APPDB_USER=appdb_user
APPDB_PASSWORD=
APPDB_DATABASE=appdb
DB_SCHEMA=bot

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
# Reutiliza el bearer del chat-bot del cliente (mismo Meta Business App).
META_WA_BEARER_TOKEN=
META_WA_APP_SECRET=
META_WA_WABA_ID=
META_WA_DEFAULT_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v17.0

# ── Rate limits (defaults; override per-campaign en bot.campaigns.rate_limit_mps) ──
CAMPAIGNS_DEFAULT_RATE_BURST_MPS=10
# Vacío = calcula del tier Meta. Setear solo para cap manual más bajo.
CAMPAIGNS_DEFAULT_DAILY_CAP_OVERRIDE=

# ── Bull Board internal auth (Fase 1.2.b wiring) ────────────────────────────
# Si seteado, /admin/queues exige header X-Cockpit-Auth con este valor.
# Si vacío, el server arranca con un warning y permite acceso (DEV ONLY).
# Producción: setear y proxiar desde cockpit con session-cookie auth.
COCKPIT_INTERNAL_TOKEN=

# ── Alertas operativas al dueño (email vía Resend) ──────────────────────────
# Email del operador/dueño para avisos críticos (ej. campaña auto-pausada por
# calidad degradada). Si vacío, el aviso solo va al log. Requiere RESEND_API_KEY
# (el mismo del canal email) para efectivamente mandar el mail.
CAMPAIGNS_ALERT_EMAIL=
